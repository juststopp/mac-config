# Inclus depuis ~/.gitconfig ([include] path = ~/dotfiles/git/gitconfig)
# Ton identité et tes identifiants restent dans ~/.gitconfig.
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Catppuccin Mocha
	file-style = bold "#cba6f7"
	hunk-header-style = omit
	minus-style = syntax "#3c2a36"
	plus-style = syntax "#2b3a35"
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
